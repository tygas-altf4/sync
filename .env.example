# SyncNFe / Plvria Sync
# Host canônico: sync.plvria.com.br
# Apex plvria.com.br = gestão escolar — não misturar.

# Ambiente SEFIN: ProducaoRestrita (homologação oficial) | Producao
# Produção exige gate explícito; cada 201 em produção é documento fiscal real.
SYNCNFE_AMBIENTE=ProducaoRestrita

# Host público do produto (DNS/Cloudflare fora deste repo)
SYNCNFE_PUBLIC_HOST=sync.plvria.com.br

# Supabase — projeto **sync plvria**. Schema: supabase/migrations/001_schema_minimo.sql
# Worker Nota Bot + hotsite Vitrine (server path) = service role / secret, só servidor.
# SUPABASE_SERVICE_ROLE_KEY: JWT `service_role` legada **ou** chave nova `sb_secret_…`
# (não é JWT — o cliente manda em `apikey`, não em Authorization Bearer).
# Alias aceito: SUPABASE_SECRET_KEY (mesmo valor).
# Anon NÃO select/insert leads (RLS). Insert do hotsite só depois do captcha, via createSupabaseClient.
# No browser: só SUPABASE_ANON_KEY + TURNSTILE_SITE_KEY. Nunca a service role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Storage (buckets privados, service-role):
#   nfse-xml      — XML DPS/NFS-e (path em nfse_docs.xml_storage_path)
#   certificates  — PFX A1 criptografado (path em establishments.certificate_vault_ref)

# Cloudflare Turnstile. Sem estas vars o captcha entra em modo stub.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit (form + signup + login + MFA). Sem Upstash = memória do processo (stub, ainda enforce).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Porta do hotsite local (`npm run web`)
# PORT=3000

# Certificado A1: NUNCA persistir PFX/PEM em coluna texto.
# Só establishments.certificate_vault_ref (Storage privado `certificates` ou secret manager).
# Não commitar arquivos *.pfx / *.p12.
